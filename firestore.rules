rules_version = '2';

// ==========================================================================
//  DOH1 — חוקי אבטחה ל-Firestore
//  שכבה 1 (פעילה): כל גישה לנתונים דורשת התחברות (ולו אנונימית) —
//  חוסמת קריאה ישירה של ה-API עם מפתח בלבד, ללא טוקן. זה מונע את
//  ה"דליפה" שבה כל אחד ברשת יכול היה למשוך את המצבת המלאה.
//
//  שכבה 2 (מומלצת, מוערת למטה): מעבר מהתחברות אנונימית להתחברות אמיתית
//  (Google/אימייל) עם רשימת-היתר, כדי שרק חיילי הגדוד המורשים ייגשו.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- שכבה 1: דרוש טוקן התחברות לכל קריאה/כתיבה ---
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // --- שכבה 2 (להפעלה עתידית): רק משתמשים מורשים ברשימת-היתר ---
    // דורש מעבר להתחברות אמיתית (לא אנונימית) והחזקת אוסף `access_list`
    // שבו לכל אימייל מורשה יש מסמך. להסיר את ההערה ולמחוק את שכבה 1:
    //
    // function isAuthorized() {
    //   return request.auth != null
    //     && request.auth.token.firebase.sign_in_provider != 'anonymous'
    //     && exists(/databases/$(database)/documents/access_list/$(request.auth.token.email));
    // }
    // match /{document=**} {
    //   allow read, write: if isAuthorized();
    // }
  }
}
